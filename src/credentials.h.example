// Optional Octopus settings template
// WiFi is configured on the device itself via the "Agile-Display-Setup" captive portal,
// so no WiFi credentials are needed here. This file is only needed to override the
// defaults below; copy it to credentials.h (git-ignored) and edit.

// Optional: Override default Octopus settings here.
// Product codes: https://docs.octopus.energy/rest/guides/endpoints/#api-price-endpoints
// Region codes (suffix): A=Eastern, B=East Midlands, C=London, D=Merseyside & N Wales,
// E=West Midlands, F=North East, G=North Scotland, H=North West, J=South East,
// K=South Scotland, L=South Wales, M=South West, N=Southern, P=Yorkshire.
#define OCTOPUS_PRODUCT_CODE "AGILE-24-10-01"
#define OCTOPUS_REGION_CODE "E"  // West Midlands
// Uncomment to override the tariff code entirely instead of product+region:
// #define OCTOPUS_TARIFF_CODE "E-1R-AGILE-24-10-01-E"
